# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric IDs. These users are ADMIN and unlimited.
ADMIN_TELEGRAM_IDS=123456789

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aimedia?schema=public
REDIS_HOST=redis
REDIS_PORT=6379

# Storage
DATA_DIR=/app/data
PUBLIC_BASE_URL=

# OpenAI: optional. Used for premium image generation/editing and AI Director.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL_PREMIUM=gpt-image-2.5-flare
OPENAI_IMAGE_MODEL_CINEMA=gpt-image-2.5-sunburst
DIRECTOR_MODEL=gpt-5.6-luna

# Runway: optional. Premium video generation.
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=gen4.5
RUNWAY_RATIO=1280:720
RUNWAY_CLIP_SECONDS=5

# Alternative Premium image/video providers, used automatically as fallback when
# OPENAI_API_KEY / RUNWAYML_API_SECRET are not set. Image order: OpenAI -> fal.ai (FLUX) ->
# FusionBrain (Kandinsky) -> YandexART. Video order: Runway -> fal.ai (Kling, image-to-video).
# Image editing (IMAGE_EDIT) still requires OpenAI specifically.

# fal.ai (https://fal.ai) - foreign card/crypto billing, no RUB. Good queue-based API,
# covers both images (FLUX) and photo->video (Kling). npm: @fal-ai/client
FAL_KEY=
FAL_FLUX_MODEL=fal-ai/flux/dev
FAL_KLING_MODEL=fal-ai/kling-video/v2.6/pro/image-to-video

# Self-deployed Modal.com endpoints (see modal-inference/). Modal's free Starter
# plan gives $30/month of GPU compute, no credit card required, GPU only bills
# while a request is running. Deploy with: modal deploy modal-inference/z_image_app.py
# (and qwen_image_app.py), then paste the printed HTTPS URLs here.
MODAL_ZIMAGE_URL=
MODAL_QWEN_IMAGE_URL=
# Wan2.2 image-to-video (modal-inference/wan_video_app.py). Needs a big GPU
# (A100-80GB by default) - still covered by the same free monthly credit if
# usage stays modest, but a single clip burns credit much faster than a photo.
MODAL_WAN_VIDEO_URL=

# Z-Image-Turbo on a free Hugging Face Space with ZeroGPU hardware
# (hf-space-zimage/). Genuinely free, no payment method anywhere - but a very
# small daily quota (5 min GPU/day on a free HF account), so this is a bonus
# low-volume fallback, not a primary provider. HF_TOKEN is optional but
# recommended (uses your own quota instead of the shared anonymous pool).
HF_SPACE_ZIMAGE_URL=
HF_TOKEN=
HF_SPACE_TIMEOUT_MS=180000

# FusionBrain / Kandinsky (Sber). Get keys at https://fusionbrain.ai/keys/
FUSIONBRAIN_API_KEY=
FUSIONBRAIN_SECRET_KEY=
FUSIONBRAIN_STYLE=
FUSIONBRAIN_POLL_MS=3000
FUSIONBRAIN_TIMEOUT_MS=180000

# YandexART (Yandex Cloud AI Studio). Get an API key + folder id from your Yandex Cloud console.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEXART_POLL_MS=3000
YANDEXART_TIMEOUT_MS=180000

# Free local mode via ComfyUI
COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_IMAGE_WORKFLOW=/app/assets/comfyui/sdxl_text_to_image_api.json
COMFYUI_EDIT_WORKFLOW=/app/assets/comfyui/sdxl_img2img_api.json
COMFYUI_VIDEO_WORKFLOW=
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_POLL_MS=2000
COMFYUI_TIMEOUT_MS=900000

# Free hosted fallback for FREE text->image/video keyframe when COMFYUI_URL is not set.
# Uses https://pollinations.ai (no signup, no API key). Images carry a small watermark
# unless POLLINATIONS_TOKEN is set. Set DISABLE_POLLINATIONS_FALLBACK=true to turn it off.
DISABLE_POLLINATIONS_FALLBACK=false
POLLINATIONS_MODEL=
POLLINATIONS_TOKEN=
POLLINATIONS_TIMEOUT_MS=120000

# User economics
FREE_DAILY_IMAGE_LIMIT=10
FREE_DAILY_VIDEO_LIMIT=3
PREMIUM_DAILY_PAID_LIMIT=20
PREMIUM_INCLUDED_CREDITS=3000
# If true, users you mark PREMIUM do not spend credits, but are still limited by PREMIUM_DAILY_PAID_LIMIT.
PREMIUM_SPONSORED=true

# Internal credits per generation. Adjust freely.
COST_IMAGE_FREE=0
COST_IMAGE_PREMIUM=40
COST_VIDEO_FREE=0
COST_VIDEO_PREMIUM_PER_5S=220
COST_LONG_VIDEO_ASSEMBLY=20

# Telegram Stars packages: stars -> credits
STARS_PACK_1_STARS=250
STARS_PACK_1_CREDITS=500
STARS_PACK_2_STARS=1000
STARS_PACK_2_CREDITS=2300
STARS_PACK_3_STARS=2500
STARS_PACK_3_CREDITS=6500
